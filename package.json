{
  "name": "deepseekondesk",
  "version": "1.0.0",
  "description": "DeepSeek 网页版桌面客户端 - Electron 封装",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite",
    "start": "F:\\electron-v42.1.0-win32-x64\\electron.exe .",
    "build": "tsc && vite build",
